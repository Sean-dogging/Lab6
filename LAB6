def update_clock():
    current_time = datetime.now().strftime("%I:%M:%S %p")
    clock_label.config(text=current_time)
    root.after(1000, update_clock)


def update_student_count():
    total_label.config(text=str(len(students)))


def refresh_table():
    # Remove existing rows
    for item in student_table.get_children():
        student_table.delete(item)

    # Add students again
    for student in students:
        student_table.insert(
            "",
            tk.END,
            values=(
                student["name"],
                student["id"],
                student["course"],
                student["year"],
                student["status"]
            )
        )

    update_student_count()


def add_student():
    name = name_entry.get().strip()
    student_id = id_entry.get().strip()
    course = course_entry.get().strip()
    year = year_combo.get().strip()

    if name == "":
        messagebox.showwarning(
            "Missing Information",
            "Please enter the student's name.",
            parent=add_window
        )
        name_entry.focus()
        return

    if student_id == "":
        messagebox.showwarning(
            "Missing Information",
            "Please enter the student ID.",
            parent=add_window
        )
        id_entry.focus()
        return

    if course == "":
        messagebox.showwarning(
            "Missing Information",
            "Please enter the course.",
            parent=add_window
        )
        course_entry.focus()
        return

    if year == "":
        messagebox.showwarning(
            "Missing Information",
            "Please select the year level.",
            parent=add_window
        )
        year_combo.focus()
        return

    # Check duplicate ID
    for student in students:
        if student["id"].lower() == student_id.lower():
            messagebox.showerror(
                "Duplicate ID",
                "That Student ID already exists.",
                parent=add_window
            )
            id_entry.focus()
            return

    # Create new student
    new_student = {
        "name": name,
        "id": student_id,
        "course": course,
        "year": year,
        "status": "Active"
    }

    students.append(new_student)

    # Refresh main table
    refresh_table()

    # Update status
    status_label.config(
        text=f"Student '{name}' was successfully added."
    )

    messagebox.showinfo(
        "Success",
        "Student added successfully!",
        parent=add_window
    )

    # Close Add Student window
    add_window.destroy()


