def search_students():
    search_text = search_entry.get().strip().lower()

    # Clear table
    for item in student_table.get_children():
        student_table.delete(item)

    # If search is empty, show all
    if search_text == "":
        refresh_table()
        return

    found = False

    for student in students:
        if (
            search_text in student["name"].lower()
            or search_text in student["id"].lower()
            or search_text in student["course"].lower()
        ):
            student_table.insert(
                "",
                tk.END,
                values=(
                    student["name"],
                    student["id"],
                    student["course"],
                    student["year"],
                    student["status"]
                )
            )
            found = True

    if found:
        status_label.config(
            text="Search results displayed."
        )
    else:
        status_label.config(
            text="No students found."
        )


def clear_search():
    search_entry.delete(0, tk.END)
    refresh_table()
    status_label.config(text="Showing all students.")


def view_student():
    selected = student_table.selection()

    if not selected:
        messagebox.showwarning(
            "No Selection",
            "Please select a student first."
        )
        return

    values = student_table.item(selected[0], "values")

    view_window = tk.Toplevel(root)
    view_window.title("Student Details")
    view_window.geometry("450x430")
    view_window.resizable(False, False)
    view_window.configure(bg=WHITE)

    view_window.transient(root)

    tk.Label(
        view_window,
        text="Student Details",
        font=("Segoe UI", 20, "bold"),
        bg=NAVY,
        fg=WHITE,
        pady=20
    ).pack(fill="x")

    details = tk.Frame(
        view_window,
        bg=WHITE
    )
    details.pack(fill="both", expand=True, padx=40, pady=30)

    information = [
        ("Student Name", values[0]),
        ("Student ID", values[1]),
        ("Course", values[2]),
        ("Year Level", values[3]),
        ("Status", values[4])
    ]

    for label, value in information:
        row = tk.Frame(
            details,
            bg=WHITE
        )
        row.pack(fill="x", pady=7)

        tk.Label(
            row,
            text=label + ":",
            font=("Segoe UI", 10, "bold"),
            bg=WHITE,
            fg=GRAY,
            width=15,
            anchor="w"
        ).pack(side="left")

        tk.Label(
            row,
            text=value,
            font=("Segoe UI", 10),
            bg=WHITE,
            fg=TEXT,
            anchor="w"
        ).pack(side="left")

    tk.Button(
        details,
        text="Close",
        font=("Segoe UI", 10, "bold"),
        bg=BLUE,
        fg=WHITE,
        relief="flat",
        cursor="hand2",
        command=view_window.destroy
    ).pack(fill="x", pady=(25, 0), ipady=8)


def delete_student():
    selected = student_table.selection()

    if not selected:
        messagebox.showwarning(
            "No Selection",
            "Please select a student to delete."
        )
        return

    values = student_table.item(selected[0], "values")
    student_id = values[1]

    confirm = messagebox.askyesno(
        "Confirm Delete",
        f"Are you sure you want to delete {values[0]}?"
    )

    if not confirm:
        return

    for student in students:
        if student["id"] == student_id:
            students.remove(student)
            break

    refresh_table()

    status_label.config(
        text=f"Student '{values[0]}' was deleted."
    )


def exit_application():
    confirm = messagebox.askyesno(
        "Exit",
        "Are you sure you want to exit?"
    )

    if confirm:
        root.destroy()


